{
  "name": "kanjiskole",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "data:fetch": "node scripts/data/fetch.ts",
    "data:build": "node scripts/data/build.ts",
    "data": "npm run data:fetch && npm run data:build",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p scripts --noEmit && tsc -p app --noEmit",
    "test": "TZ=Europe/Copenhagen vitest run",
    "test:watch": "TZ=Europe/Copenhagen vitest",
    "web": "npm run web -w app",
    "build:web": "cd app && EXPO_NO_TELEMETRY=1 npx expo export -p web",
    "audit": "node scripts/audit.ts",
    "check:native": "node scripts/check-native-dupes.ts",
    "notices": "node scripts/notices.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "react-native-gesture-handler": "3.3.0",
    "react-native-worklets": "0.13.0"
  },
  "license": "GPL-3.0-only"
}
