{
  "name": "kanjiskole",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18" },
  "workspaces": ["packages/*"],
  "scripts": {
    "data:fetch": "node scripts/data/fetch.ts",
    "data:build": "node scripts/data/build.ts",
    "data": "npm run data:fetch && npm run data:build",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p scripts --noEmit",
    "test": "TZ=Europe/Copenhagen vitest run",
    "test:watch": "TZ=Europe/Copenhagen vitest"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  }
}
