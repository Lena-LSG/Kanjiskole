{
  "name": "kanjiskole",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "data:fetch": "node scripts/data/fetch.ts",
    "data:build": "node scripts/data/build.ts",
    "data": "npm run data:fetch && npm run data:build",
    "typecheck": "tsc -p packages/core --noEmit && tsc -p scripts --noEmit && tsc -p app --noEmit",
    "test": "TZ=Europe/Copenhagen vitest run",
    "test:watch": "TZ=Europe/Copenhagen vitest",
    "web": "npm run web -w app",
    "build:web": "cd app && EXPO_NO_TELEMETRY=1 npx expo export -p web",
    "audit": "node scripts/audit.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
